# ============================================================
# ESSOR AUTOMATIONS — environment
# Copy to .env.local for local dev, and paste the same values into
# Vercel > Project > Settings > Environment Variables for production.
# ============================================================

# Supabase > Project Settings > API
# Safe to expose: the anon key is public by design and Row Level Security
# is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL, used for metadata, sitemap and OG tags
NEXT_PUBLIC_SITE_URL=https://essorautomations.in

# Optional analytics. Left empty, no script is loaded at all.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
